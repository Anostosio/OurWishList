{
  "version": 2,
  "builds": [
    { "src": "wishlist/miniapp/index.html", "use": "@vercel/static" },
    { "src": "wishlist/miniapp/assets/**", "use": "@vercel/static" },
    { "src": "api/index.py", "use": "@vercel/python" },
    { "src": "api/telegram.py", "use": "@vercel/python" }
  ],
  "routes": [
    { "src": "/telegram/webhook", "dest": "/api/telegram.py" },
    { "src": "/api/(.*)", "dest": "/api/index.py" },
    { "src": "/assets/(.*)", "dest": "/wishlist/miniapp/assets/$1" },
    { "src": "/(.*)", "dest": "/wishlist/miniapp/index.html" }
  ]
}
